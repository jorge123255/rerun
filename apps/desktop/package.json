{
    "name": "@rerun/desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Rerun desktop app shell (internal preview build)",
    "type": "module",
    "main": "dist/main/index.js",
    "scripts": {
        "test": "node --test test/*.test.mjs src/main/remote-machines/*.test.mjs",
        "stage": "node ../../scripts/desktop/package.mjs --stage-only",
        "package": "node ../../scripts/desktop/package.mjs",
        "package:dmg": "node ../../scripts/desktop/package.mjs --dmg",
        "verify": "node ../../scripts/desktop/verify-runtime.mjs"
    },
    "devDependencies": {
        "electron": "44.9.0",
        "electron-builder": "26.18.1"
    },
    "license": "AGPL-3.0-only"
}
