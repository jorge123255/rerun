{
    "name": "rerun-monorepo",
    "description": "Rerun: AI coworkers that run your work",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@8.15.4",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build:contracts": "pnpm --filter @rerun/contracts build",
        "build": "pnpm -r build",
        "dev:engine": "pnpm --filter rerun-engine dev",
        "dev:ui": "pnpm --filter rerun dev",
        "dev:ui:full": "concurrently -k -n next,engine -c cyan,green \"pnpm --filter rerun dev\" \"pnpm --filter rerun-engine dev\"",
        "dev:docs": "cd apps/docs && npx --yes mint dev --port 3333",
        "check:docs": "cd apps/docs && npx --yes mint validate && npx --yes mint broken-links",
        "typecheck": "pnpm -r --if-present ts-check",
        "i18n:check": "node scripts/i18n-check.mjs",
        "i18n:index": "node scripts/i18n-index.mjs",
        "db:new": "supabase migration new",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:reset": "supabase db reset",
        "db:fresh:local": "supabase start && supabase db reset",
        "desktop:package": "node scripts/desktop/package.mjs",
        "desktop:install": "node scripts/desktop/install.mjs",
        "desktop:stage": "node scripts/desktop/package.mjs --stage-only",
        "desktop:verify": "node scripts/desktop/verify-runtime.mjs"
    },
    "devDependencies": {
        "concurrently": "^10.0.4",
        "supabase": "^2.113.0",
        "typescript": "^5.8.3"
    },
    "pnpm": {
        "overrides": {
            "ai-sdk-provider-codex-cli@1.3.1>@openai/codex": "0.166.0",
            "@anthropic-ai/claude-agent-sdk": "0.3.322"
        },
        "patchedDependencies": {
            "ai-sdk-provider-codex-cli@1.3.1": "apps/engine/patches/ai-sdk-provider-codex-cli@1.3.1.patch"
        }
    },
    "license": "AGPL-3.0-only"
}
