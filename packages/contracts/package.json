{
    "name": "@rerun/contracts",
    "version": "0.1.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./mac-phone-pairing": {
            "types": "./dist/mac-phone-pairing.d.ts",
            "import": "./dist/mac-phone-pairing.js",
