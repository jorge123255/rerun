(version 1)
; Keep native TLS and Keychain services available. Personal files and other executables are
; outside the runner's scope even if a future Codex feature exposes a new built-in tool.
(allow default)
(deny file-read-data file-write* process-exec)
(allow file-read-data (literal "/") (subpath "/System") (subpath "/usr") (subpath "/Library/Apple") (subpath "/Library/Keychains") (subpath "/private/etc") (subpath "/dev") (literal (param "BINARY")))
(allow file-read-data file-write* (subpath (param "PROFILE")) (literal (param "OUTPUT")) (literal "/dev/null"))
; Structured output adds no directory read or write permission.
(allow file-read-data (literal (param "SCHEMA")))
(allow process-exec (literal (param "BINARY")))
(if (equal? (param "HOST_ALLOWED") "1")
    (allow file-read-data process-exec (literal (param "HOST"))))

; Security.framework uses a lock and an atomic swap for the default Keychain. Only the
; account RPC worker can perform that swap. Inference gets read-only Keychain access.
(allow file-read-data (literal (param "KEYDIR")) (literal (param "KEYCHAIN")) (prefix (string-append (param "KEYDIR") "/.fl")))
(if (equal? (param "ACCOUNT") "1")
    (begin
        (allow file-read-data file-write* (prefix (string-append (param "KEYCHAIN") ".sb-")) (prefix (string-append (param "KEYDIR") "/.fl")))
        (allow file-write-create file-write-unlink (literal (param "KEYCHAIN")))))
